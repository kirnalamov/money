# ================================
# Application Configuration
# ================================

# Project name displayed in API docs
PROJECT_NAME=Money App

# API version prefix (e.g., /api/v1)
API_V1_STR=/api/v1

# ================================
# Security Settings
# ================================

# CRITICAL: Change this to a random secret key in production!
# Generate with: openssl rand -hex 32
# Or: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_TO_A_RANDOM_SECRET_KEY

# JWT algorithm
ALGORITHM=HS256

# Access token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiration in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# ================================
# CORS Configuration
# ================================

# Allowed origins for CORS (comma-separated)
# Example: http://localhost:3000,https://yourdomain.com
# Leave empty to disable CORS (NOT recommended for production with frontend)
BACKEND_CORS_ORIGINS=http://localhost:3000

# ================================
# Database Configuration
# ================================

# PostgreSQL server host
POSTGRES_SERVER=db

# PostgreSQL server port (default: 5432)
# POSTGRES_PORT=5432

# PostgreSQL database name
POSTGRES_DB=app

# PostgreSQL username
POSTGRES_USER=postgres

# PostgreSQL password
POSTGRES_PASSWORD=postgres

# Full database URL (optional - auto-generated from above if not set)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/app

# ================================
# Rate Limiting
# ================================

# General API rate limit (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Authentication endpoints rate limit (requests per minute)
# Lower limit for auth endpoints to prevent brute force attacks
AUTH_RATE_LIMIT_PER_MINUTE=5

# ================================
# Logging Configuration
# ================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: "console" for human-readable, "json" for structured logging in production
LOG_FORMAT=console

# ================================
# Initial Superuser (Optional)
# ================================

# Configuration for creating initial superuser
# Used by the database initialization script
# FIRST_SUPERUSER_EMAIL=admin@example.com
# FIRST_SUPERUSER_USERNAME=admin
# FIRST_SUPERUSER_PASSWORD=ChangeThisPassword123!
# FIRST_SUPERUSER_FULL_NAME=Admin User

# ================================
# Production Security Notes
# ================================

# 1. ALWAYS change SECRET_KEY to a random value in production
# 2. Use strong passwords for POSTGRES_PASSWORD
# 3. Set BACKEND_CORS_ORIGINS to only trusted domains
# 4. Use LOG_FORMAT=json in production for better log parsing
# 5. Consider using environment-specific .env files (.env.production, .env.staging)
# 6. Never commit .env files to version control (already in .gitignore)
# 7. Use secrets management services in production (AWS Secrets Manager, Azure Key Vault, etc.)
