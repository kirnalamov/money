PROJECT_NAME=MoneyApp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=app
DATABASE_URL=postgresql+asyncpg://postgres:replace_with_a_strong_database_password@db:5432/app
SECRET_KEY=replace_with_a_random_secret_at_least_32_characters_long
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
DEV_MODE=false
LOG_FORMAT=json
LOG_LEVEL=INFO
EXCHANGE_RATES_URL=https://open.er-api.com/v6/latest/USD
EXCHANGE_RATES_TTL_MINUTES=60

# Optional initial administrator. Leave unset unless explicitly needed.
